# Claude API anahtarı (zorunlu). Gerçek değeri sadece .env dosyasına yaz.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5

# Veritabanı dosyası ve uygulamanın adresi (şifre sıfırlama bağlantısında kullanılır).
DATABASE_PATH=talkbuddy.db
APP_URL=http://localhost:8080

# Site HTTPS üzerinden yayınlandığında true yap.
COOKIE_SECURE=false

# E-posta (isteğe bağlı). Boş kalırsa sıfırlama bağlantısı sunucu terminaline yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Konuşma tanıma modeli (Whisper): tiny, base, small, medium. Büyüdükçe daha doğru ama daha yavaş.
# "off" yazılırsa tarayıcının kendi tanıması kullanılır.
WHISPER_MODEL=small
